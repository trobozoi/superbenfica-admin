# =============================================================================
# Super Benfica - Painel Administrativo
# Copie para .env.local e ajuste. Para PRODUÇÃO, troque apenas estas URLs.
# Nenhum segredo do backend (SECRET_KEY, banco etc.) deve ficar aqui.
# =============================================================================

# URL da API Django usada pelo servidor Next (BFF / route handlers).
# Dev: http://127.0.0.1:8000 | Docker: http://host.docker.internal:8000
API_URL=http://127.0.0.1:8000

# URL do WebSocket (Django Channels) acessada pelo navegador.
# Produção: wss://api.seudominio.com.br
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# development | staging | production (controla cookies Secure, HSTS e logs)
NEXT_PUBLIC_APP_ENV=development
